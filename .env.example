# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel : ID de ton serveur -> commandes disponibles instantanément (sinon global, ~1h)
DISCORD_GUILD_ID=

# --- Radar ---
DEAL_RADAR_INTERVAL_MIN=10
DEAL_RADAR_ENABLED=true

# --- Analyse de capture d'écran (optionnel) : clé API Google AI Studio (aistudio.google.com/apikey) ---
# Sans clé : les mentions, /deals et l'analyse par LIEN marchent ; seule la capture d'écran est désactivée.
# Fournisseur au choix. Ordre de priorité si plusieurs clés : Gemini, puis OpenAI, puis Anthropic.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite   # plus précis : gemini-3.6-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra     # moins cher : gpt-6-luna
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=gemini             # force gemini, openai ou anthropic

# Optionnel : lire aussi le contenu des messages auxquels on répond (activer "Message Content Intent" dans le portail)
# MESSAGE_CONTENT_INTENT=true

# --- eBay (API officielle, optionnel) : developer.ebay.com -> Application Keys -> jeu de clés PRODUCTION ---
# Sans ces deux variables, eBay est désactivé automatiquement.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_FR
# EBAY_CURRENCY=EUR
# EBAY_DOMAIN=ebay.fr

# --- Vinted ---
VINTED_DOMAIN=vinted.fr
VINTED_MIN_GAP_MS=4000

# --- Leboncoin (voir server/lbc_bridge.py) ---
# LBC_CITY=Paris
# LBC_LAT=48.8566
# LBC_LNG=2.3522
# LBC_RADIUS=30000
# LBC_PROXY_HOST=
# LBC_PROXY_PORT=
# LBC_PROXY_USER=
# LBC_PROXY_PASS=
SEARCH_CACHE_TTL_S=300
