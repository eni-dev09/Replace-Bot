# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel : ID de ton serveur -> commandes disponibles instantanément (sinon global, ~1h)
DISCORD_GUILD_ID=

# --- Radar ---
DEAL_RADAR_INTERVAL_MIN=10
DEAL_RADAR_ENABLED=true

# --- Analyse de capture d'écran (optionnel) : clé API OpenAI (platform.openai.com) ---
# Sans clé : les mentions, /deals et l'analyse par LIEN marchent ; seule la capture d'écran est désactivée.
# Fournisseur au choix. OpenAI est utilisé en priorité si sa clé est présente.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra     # moins cher : gpt-6-luna
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=openai             # force openai ou anthropic

# Optionnel : lire aussi le contenu des messages auxquels on répond (activer "Message Content Intent" dans le portail)
# MESSAGE_CONTENT_INTENT=true

# --- Vinted ---
VINTED_DOMAIN=vinted.fr
VINTED_MIN_GAP_MS=4000

# --- Leboncoin (voir server/lbc_bridge.py) ---
# LBC_CITY=Paris
# LBC_LAT=48.8566
# LBC_LNG=2.3522
# LBC_RADIUS=30000
# LBC_PROXY_HOST=
# LBC_PROXY_PORT=
# LBC_PROXY_USER=
# LBC_PROXY_PASS=
SEARCH_CACHE_TTL_S=300
